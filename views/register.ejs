<!DOCTYPE html><html lang="en"><head><%- include('partials/head') %></head><body><%- include('partials/menu') %><main class="auth-wrap"><section class="auth-card"><div class="auth-logo"><img src="<%= siteSettings.site_logo %>" alt="<%= siteSettings.site_name %>"></div><h1>Create your account</h1><p>Create a client account to access your dashboard and purchase products.</p><% if(error){ %><div class="auth-error"><%= error %></div><% } %><form method="post" action="/register"><label for="name">Name</label><input id="name" type="text" name="name" required autocomplete="name"><label for="email">Email</label><input id="email" type="email" name="email" required autocomplete="email"><label for="password">Password</label><input id="password" type="password" name="password" minlength="6" required autocomplete="new-password"><label for="discord_id">Discord User ID <span style="color:#f87171">*</span></label><input id="discord_id" type="text" name="discord_id" inputmode="numeric" pattern="[0-9]{17,20}" minlength="17" maxlength="20" value="<%= form && form.discord_id ? form.discord_id : '' %>" placeholder="17–20 digit Discord User ID" required><small class="muted">Required for order/payment notifications. Discord Developer Mode → Copy User ID.</small><button class="bc-btn auth-submit" type="submit">Create Account</button></form><div class="auth-link">Already have an account? <a href="/login">Login</a></div></section></main></body></html>
