<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
<%- include('partials/menu') %>
<main style="max-width:1100px;margin:0 auto;padding:32px 20px">
  <h1>Client Dashboard</h1>
  <p>Welcome, <%= user.name %>.</p>
  <section style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:24px">
    <div class="auth-card"><h2>Orders</h2><strong><%= orders.length %></strong></div>
    <div class="auth-card"><h2>Services</h2><strong><%= services.length %></strong></div>
  </section>
  <section class="auth-card" style="max-width:none;margin-top:24px">
    <h2>My Orders</h2>
    <% if (!orders.length) { %><p>No orders yet.</p><% } else { orders.forEach(function(order){ %>
      <div style="padding:12px 0;border-bottom:1px solid rgba(255,255,255,.1)">
        <strong><%= order.id || order.order_id || 'Order' %></strong> — <%= order.status || order.order_status || 'Pending' %>
      </div>
    <% }); } %>
  </section>
</main>
</body>
</html>
