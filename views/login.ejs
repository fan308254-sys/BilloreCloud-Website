<!DOCTYPE html><html lang="en"><head><%- include('partials/head') %></head><body><%- include('partials/menu') %><main class="auth-wrap"><section class="auth-card"><div class="auth-logo"><img src="<%= siteSettings.site_logo %>" alt="<%= siteSettings.site_name %>"></div><h1>Welcome back</h1><p>Login to your <%= siteSettings.site_name %> client account.</p><% if(error){ %><div class="auth-error"><%= error %></div><% } %><form method="post" action="/login"><input type="hidden" name="next" value="<%= next || '/panel' %>"><label for="email">Email</label><input id="email" type="email" name="email" required autocomplete="email"><label for="password">Password</label><input id="password" type="password" name="password" required autocomplete="current-password"><button class="bc-btn auth-submit" type="submit">Login</button></form><div class="auth-link">Don't have an account? <a href="/register">Create Account</a></div></section></main></body></html>
