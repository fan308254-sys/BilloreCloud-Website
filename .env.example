PORT=3000
SESSION_SECRET=change-this-to-a-long-random-secret

# Admin Dashboard login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Discord bot notifications
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=
DISCORD_NEW_ORDERS_CATEGORY_ID=
DISCORD_NEW_ORDERS_CHANNEL_ID=
DISCORD_COMPLETE_ORDERS_CATEGORY_ID=
DISCORD_COMPLETE_ORDERS_CHANNEL_ID=

# Discord Connect / OAuth2 (can also be configured from Admin > Discord Connect)
DISCORD_ENABLED=true
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://your-domain.com/auth/discord/callback
